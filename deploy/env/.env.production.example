NODE_ENV=production
APP_PORT=3000
PORT=3000
SITE_URL=http://187.127.153.47
NEXT_PUBLIC_SITE_URL=http://187.127.153.47
TRUST_PROXY=true

DATABASE_PATH=/var/lib/bakery_ecom/bakery.sqlite
UPLOADS_DIR=/var/lib/bakery_ecom/uploads
PUBLIC_UPLOADS_BASE_URL=/images/uploads

ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_AUTH_SECRET=replace-with-a-generated-random-secret-at-least-32-characters
ADMIN_SESSION_TTL_SECONDS=43200

NEXT_PUBLIC_UPI_QR_IMAGE=/images/payments/ks-choco-house-upi-qr.png
NEXT_PUBLIC_UPI_LABEL=Pay via UPI QR

# IP-only deployment stays on HTTP until a real domain is available.
# Let's Encrypt cannot issue a normal certificate for a bare server IP.
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
